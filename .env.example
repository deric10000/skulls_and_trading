# Vite (SPA) — copy to `.env.local` (git-ignored)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Only enable after strategy_check_* result tables are populated by Edge/Queue.
# Empty results + authoritative = Score Pending / 0 conviction across Helm.
# VITE_SERVER_SCORING_ENABLED=authoritative

# Worker `.dev.vars` / wrangler secrets
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# MARKET_AUTH_REQUIRED=false   # local open market proxy; omit/true in prod
# ENABLE_DEMO_GATE=false       # Demo Captain retired for Beta
