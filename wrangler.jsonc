{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skullsandtrading",
  "compatibility_date": "2026-06-13",
  "main": "worker/index.ts",
  "triggers": {
    // Free Workers cap each invocation at 50 external subrequests. Short
    // one-minute shards checkpoint an hourly sweep without long-running overlap.
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      // Wrangler 4.45+ provisions this namespace automatically on deploy.
      "binding": "MARKET_CACHE"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONVICTION_CYCLE_QUEUE",
        "queue": "conviction-cycle"
      }
    ],
    "consumers": [
      {
        "queue": "conviction-cycle",
        // One Edge Function request per message. Ten stays well below the
        // Free Worker limit of 50 external subrequests per invocation.
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "conviction-cycle-dead-letter"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Ensure /api/* hits the Worker before SPA asset fallback
    // (otherwise navigate/fetch can get index.html instead of JSON).
    "run_worker_first": ["/api/*", "/__scheduled"]
  }
}
